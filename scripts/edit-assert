def eprint(msg):
    sys.stderr.write(msg + "\n")


def now_iso():
    return time.strftime("%Y-%m-%dT%H:%M:%S%z", time.localtime())


def sha256_bytes(b):
    return hashlib.sha256(b).hexdigest()


def sha256_file(path):
    h = hashlib.sha256()
    with open(path, "rb") as fh:
        while True:
            chunk = fh.read(1 << 16)
            if not chunk:
                break
            h.update(chunk)
    return h.hexdigest()


def read_bytes(path):
    with open(path, "rb") as fh:
        return fh.read()


# ══════════════════════════════════════════════════════════════════
# 1. 墙钟符（本机**没有** `timeout` 命令 —— C7；一切外部命令都从这里走）
# ══════════════════════════════════════════════════════════════════

def run_clocked(argv, clock, cwd=None):
    """跑一条外部命令：自带墙钟上界；超时 ⇒ 杀**整个进程组**并如实回报。

    返回 dict：rc / out / err / elapsed / timeout / argv（台账里原样留 argv）。
    ⚠ 本机实测 `/bin/bash: timeout: command not found` ⇒ 上界只能自带（D2/C7）。
    """
    t0 = time.time()
    proc = subprocess.Popen(
        argv, cwd=cwd, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        stdin=subprocess.DEVNULL, preexec_fn=os.setsid)
    try:
        out, err = proc.communicate(timeout=clock)
        return {"rc": proc.returncode, "out": out.decode("utf-8", "replace"),
                "err": err.decode("utf-8", "replace"), "elapsed": time.time() - t0,
                "timeout": False, "argv": argv}
    except subprocess.TimeoutExpired:
        try:
            os.killpg(os.getpgid(proc.pid), signal.SIGKILL)
        except (OSError, ProcessLookupError):
            try:
                proc.kill()
            except OSError:
                pass
        try:
            out, err = proc.communicate(timeout=10)
        except subprocess.TimeoutExpired:
            out, err = b"", b""
        return {"rc": None, "out": out.decode("utf-8", "replace"),
                "err": err.decode("utf-8", "replace"), "elapsed": time.time() - t0,
                "timeout": True, "argv": argv}


# ══════════════════════════════════════════════════════════════════
# 2. 异常与判定载体
# ══════════════════════════════════════════════════════════════════

class Blocked(Exception):
    """前置不足 ⇒ rc=2 不给结论（绝不许降级或静默放过）。"""

    def __init__(self, code, msg, detail=None):
        Exception.__init__(self, "%s: %s" % (code, msg))
        self.code = code
        self.msg = msg
        self.detail = detail or []


class Failed(Exception):
    """判据不过 ⇒ rc=1（真红）。"""

    def __init__(self, code, msg, detail=None):
        Exception.__init__(self, "%s: %s" % (code, msg))
        self.code = code
        self.msg = msg
        self.detail = detail or []


class Ctx(object):
    """一次门运行的上下文（含负控取反开关）。"""

    def __init__(self, cfg):
        self.cfg = cfg
        self.neg = set(cfg.get("neg") or [])   # 被负控取反的断言名
        self.warnings = []
        self.steps = []

    def inverted(self, name):
        return name in self.neg

    def say(self, line=""):
        print(line)
        self.steps.append(line)

    def warn(self, code, msg):
        self.warnings.append({"code": code, "msg": msg})
        print("⚠ [%s] %s" % (code, msg))


# ══════════════════════════════════════════════════════════════════
# 3. 台账（§7.4 定案落点 · C2 的 begin/end 两行 · J6 未收尾检测）
# ══════════════════════════════════════════════════════════════════

def resolve_ledger_path(cfg):
    """返回 (路径, 来源串)。**不许静默退化到 /tmp**（§7.4 反面落点）。"""
    if cfg.get("ledger_path"):
        return cfg["ledger_path"], "--ledger-path（显式覆盖）"
    env = os.environ.get("ZERG_STATE_DIR")
    if env:
        return os.path.join(env, LEDGER_NAME), "ZERG_STATE_DIR=%s" % env
    return (os.path.join(STATE_DIR_DEFAULT, LEDGER_NAME),
            "默认 %s（ZERG_STATE_DIR 未设 —— 逐字抄 chat-harness.py:30）" % os.path.dirname(STATE_DIR_DEFAULT))


class Ledger(object):
    def __init__(self, ctx):
        self.ctx = ctx
        self.path, self.source = resolve_ledger_path(ctx.cfg)
        self.dir = os.path.dirname(os.path.abspath(self.path))

    @staticmethod
    def _is_tmp(path):
        p = os.path.abspath(path) + os.sep
        return any(p.startswith(pre) for pre in TMP_PREFIXES)

    def startup(self):
        ctx = self.ctx
        ctx.say("── 台账（§7.4 定案落点 · 路径解析逐字抄 chat-harness.py:30）──")
        ctx.say("   台账路径：%s" % self.path)
        ctx.say("   来源：%s" % self.source)
        if ctx.inverted("LEDGER_PATH_REAL") and self._is_tmp(self.dir):
            raise Failed("FAIL_NEG_INVERTED",
                         "负控：LEDGER_PATH_REAL 被取反 ⇒ 台账落点断言判红（落点在 /tmp：%s）" % self.dir)
        default_source = not (ctx.cfg.get("ledger_path") or os.environ.get("ZERG_STATE_DIR"))
        if self._is_tmp(self.dir):
            if default_source:
                raise Blocked("BLOCKED_LEDGER_TMP",
                              "默认落点解析到 /tmp（%s）—— /tmp 会被「重启即清 + tmp_cleaner 3 天未访问即删」"
                              "（statepath.go:1-3）⇒ 不给结论，也**不静默换地方**" % self.dir)
            ctx.warn("WARN_LEDGER_TMP", "台账落点在 /tmp（%s，**显式**给的值）：测试可、生产不可" % self.dir)
        try:
            if not os.path.isdir(self.dir):
                os.makedirs(self.dir)
            fh = open(self.path, "a")
            fh.close()
        except (IOError, OSError) as exc:
            raise Blocked("BLOCKED_LEDGER_UNWRITABLE",
                          "台账不可写：%s（%s）⇒ rc=2，且**不许**静默退化到 /tmp" % (self.path, exc))
        ctx.say("   可写性：✓（%s）· 现有行数 %d" % (self.dir, self.line_count()))
        self.unfinished_check()
        return 0

    def lines(self):
        if not os.path.isfile(self.path):
            return [], []
        rows, bad = [], []
        with open(self.path, "r", encoding="utf-8", errors="replace") as fh:
            for i, ln in enumerate(fh, 1):
                ln = ln.strip()
                if not ln:
                    continue
                try:
                    obj = json.loads(ln)
                except ValueError:
                    bad.append((i, ln[:120]))
                    continue
                if isinstance(obj, dict):
                    rows.append(obj)
                else:
                    bad.append((i, ln[:120]))
        return rows, bad

    def line_count(self):
        n = 0
        with open(self.path, "r", encoding="utf-8", errors="replace") as fh:
            for _ in fh:
                n += 1
        return n

    def unfinished_check(self):
        """J6 / C2：有 begin 无 end ⇒ rc=2 + 打印残留文件路径 + 当前 sha256。"""
        rows, bad = self.lines()
        if bad:
            for i, raw in bad:
                eprint("✗ 台账第 %d 行不可解析：%s" % (i, raw))
            raise Blocked("BLOCKED_LEDGER_CORRUPT",
                          "台账里 %d 行不可解析 ⇒ 未收尾检测不可信 ⇒ 不给结论" % len(bad))
        begins, ends = {}, {}
        for r in rows:
            rid = r.get("run_id")
            if not rid:
                continue
            if r.get("phase") == "begin":
                begins[rid] = r
            elif r.get("phase") == "end":
                ends[rid] = r
        open_runs = [rid for rid in begins if rid not in ends]
        if not open_runs:
            self.ctx.say("   未收尾检测（J6）：✓ 无「有 begin 无 end」的组（begin %d · end %d）"
                         % (len(begins), len(ends)))
            return 0
        if self.ctx.inverted("LEDGER_UNFINISHED"):
            raise Blocked("BLOCKED_UNFINISHED", "负控：LEDGER_UNFINISHED 取反（本可放过）⇒ 仍按不给结论处置")
        self.ctx.say("   未收尾检测（J6）：✗ 有 %d 组只有 begin 没有 end ⇒ rc=2" % len(open_runs))
        residual = []
        for rid in open_runs:
            r = begins[rid]
            tgt = r.get("target")
            cur = sha256_file(tgt) if (tgt and os.path.isfile(tgt)) else None
            self.ctx.say("       · run_id=%s · 目标=%s" % (rid, tgt))
            self.ctx.say("         前像 pre_sha=%s · 当前 sha256=%s ⇒ %s"
                         % (r.get("pre_sha"), cur,
                            "未受影响（与前像一致）" if cur == r.get("pre_sha") else "**有残留改动**（与前像不一致）"))
            residual.append("残留目标：%s · 前像 pre_sha=%s · 当前 sha256=%s（%s）"
                            % (tgt, r.get("pre_sha"), cur,
                               "未受影响" if cur == r.get("pre_sha") else "**有残留改动**"))
        raise Blocked("BLOCKED_UNFINISHED",
                      "台账有 begin 无 end（上一轮没收尾，C2/J6）⇒ 不给结论。复原口径：门内失败由门按"
                      "**内存前像字节**自动复原（已实现）；进程被杀则前像字节不可得 ⇒ 按上面的 pre_sha256 "
                      "与 `git diff` 人工核验后复原（门**不替人动手**）", detail=residual)

    def find_replay(self, xform_key):
        """查台账：同一变换是否已收尾且目标仍停在 post 态 ⇒ 本跑是**幂等复跑**（E5）。"""
        rows, _bad = self.lines()
        hit = None
        for r in rows:
            if r.get("phase") == "end" and r.get("xform_key") == xform_key and r.get("post_sha"):
                hit = r
        return hit

    def append(self, row):
        # append-only：只允许 push 一行（不改、不删、不重写）
        with open(self.path, "a", encoding="utf-8") as fh:
            fh.write(json.dumps(row, ensure_ascii=False) + "\n")
        return row


# ══════════════════════════════════════════════════════════════════
# 4. 工具账（tools/cli-tools.json）+ 启动断言（§6.4-3 · M15）
# ══════════════════════════════════════════════════════════════════

def load_tools_account():
    if not os.path.isfile(TOOLS_ACCOUNT):
        return None, "登记账文件不存在：%s" % TOOLS_ACCOUNT
    try:
        with open(TOOLS_ACCOUNT, "r", encoding="utf-8") as fh:
            data = json.load(fh)
    except (IOError, OSError, ValueError) as exc:
        return None, "登记账读不出/不可解析：%s（%s）" % (TOOLS_ACCOUNT, exc)
    if not isinstance(data.get("tools"), list):
        return None, "登记账里没有 `tools` 列表：%s" % TOOLS_ACCOUNT
    return data, None


def resolve_ast_grep(ctx):
    """工具可得性 + 启动断言：不在登记路径 / 指纹不符 ⇒ rc=2（§6.4-3）。"""
    cfg = ctx.cfg
    if ctx.inverted("PRE_ORDER"):
        raise Failed("FAIL_NEG_INVERTED", "负控：PRE_ORDER 被取反 ⇒ 缺件阶段的原因码不可信")
    path = cfg.get("ast_grep") or shutil.which("ast-grep")
    if not path:
        raise Blocked("BLOCKED_MISSING_TOOL",
                      "ast-grep 不在 PATH（可用 `--ast-grep <绝对路径>` 指定；**禁止**降级到文本锚点，M5）")
    if not os.path.isfile(path):
        raise Blocked("BLOCKED_MISSING_TOOL", "ast-grep 路径不存在：%s" % path)
    acct, err = load_tools_account()
    if err:
        raise Blocked("BLOCKED_UNREGISTERED_TOOL",
                      "工具在（%s）但 CLI 依赖账读不到：%s ⇒ 不给结论（M15 防漂移）" % (path, err))
    entry = None
    for t in acct["tools"]:
        if isinstance(t, dict) and t.get("name") == "ast-grep":
            entry = t
            break
    if entry is None:
        raise Blocked("BLOCKED_UNREGISTERED_TOOL",
                      "CLI 依赖账（%s）里没有 ast-grep 条目 ⇒ 不给结论" % TOOLS_ACCOUNT)
    real = os.path.realpath(path)
    reg_paths = [p for p in (entry.get("abs_path"), entry.get("real_path")) if p]
    sha = sha256_file(path)
    reg_sha = entry.get("binary_sha256")
    path_ok = (os.path.abspath(path) in [os.path.abspath(p) for p in reg_paths]) or \
              (real in [os.path.realpath(p) for p in reg_paths])
    sha_ok = (sha == reg_sha)
    if not (path_ok or sha_ok):
        raise Blocked("BLOCKED_UNREGISTERED_TOOL",
                      "ast-grep 在 %s（real=%s · sha256=%s），登记账写的是 %s（sha256=%s）——"
                      "**不在登记路径且指纹不符** ⇒ 不给结论；确认后更新 tools/cli-tools.json 再跑"
                      % (path, real, sha[:16], reg_paths, (reg_sha or "(无)")[:16]))
    res = run_clocked([path, "--version"], cfg["clock"])
    if res["timeout"]:
        raise Blocked("BLOCKED_TIMEOUT", "`ast-grep --version` 超时（%ds）⇒ 不给结论" % cfg["clock"])
    vlines = (res["out"] or res["err"]).strip().splitlines()
    version = vlines[0].replace("ast-grep ", "").strip() if vlines else "(不可考)"
    if not sha_ok:
        ctx.warn("WARN_RULE_FIELD", "ast-grep 的 binary sha256 与登记账不符（%s vs %s）⇒ 建议重新登记"
                 % (sha[:16], (reg_sha or "(无)")[:16]))
    ctx.say("── 工具账（§6.4：启动打印工具名 + 版本 + binary sha256，并落台账字段）──")
    ctx.say("   ast-grep %s · %s（real=%s）· binary sha256=%s" % (version, path, real, sha))
    ctx.say("   登记账 %s：abs_path=%s real_path=%s sha256=%s ⇒ %s"
            % (os.path.relpath(TOOLS_ACCOUNT, REPO_ROOT), entry.get("abs_path"), entry.get("real_path"),
               (reg_sha or "(无)"), "路径命中" if path_ok else "按 sha256 命中（路径不同）"))
    return {"path": path, "real": real, "version": version, "sha256": sha}


# ══════════════════════════════════════════════════════════════════
# 5. 规则检查（R-7）+ 可解析性前置（M7）+ 定位（R-8）
# ══════════════════════════════════════════════════════════════════

def load_rule(ctx, rule_path):
    if not rule_path:
        raise Blocked("BLOCKED_USAGE", "--rule 未给（定位只走 `scan -r <rule.yml>`，没有第二条路）")
    if not os.path.isfile(rule_path):
        raise Blocked("BLOCKED_MISSING_TOOL", "规则文件不存在：%s（缺件 ⇒ rc=2，不降级）" % rule_path)
    text = open(rule_path, "r", encoding="utf-8", errors="replace").read()
    sha = sha256_bytes(text.encode("utf-8"))
    has_rel = ("inside:" in text) or ("has:" in text)
    if ctx.inverted("RULE_SCOPE") and has_rel and "stopBy" not in text:
        raise Failed("FAIL_NEG_INVERTED", "负控：RULE_SCOPE 被取反 ⇒ 越界规则也放行（本可拦住 stopBy 缺失）")
    if has_rel and "stopBy" not in text:
        raise Blocked("BLOCKED_RULE_SCOPE",
                      "规则 %s 用了 inside/has 但没写 `stopBy: end` —— 官方默认 `stopBy: neighbor` ⇒ "
                      "**静默零命中**（R-7 实测）⇒ 不给结论。照 %s 写"
                      % (rule_path, os.path.relpath(RULE_TEMPLATE, REPO_ROOT)))
    if "has:" in text and "field:" not in text:
        ctx.warn("WARN_RULE_FIELD",
                 "规则 %s 有 `has:` 但没写 `field:` ⇒ 同一文件里别处出现同名标识符时会**误伤**（R-7 第二条）"
                 % rule_path)
    return {"path": rule_path, "sha256": sha, "text": text}


def parse_precheck(ctx, target):
    """可解析性前置（M7）：Go 用 `gofmt -e`、Python 用 `ast.parse`（对齐 precommit-gates.sh:233-243）。"""
    ext = os.path.splitext(target)[1].lower()
    if ctx.inverted("PRE_PARSE"):
        raise Blocked("BLOCKED_UNPARSABLE", "负控：PRE_PARSE 被取反 ⇒ 可解析性前置判不过")
    if ext == ".go":
        gofmt = shutil.which("gofmt")
        if not gofmt:
            raise Blocked("BLOCKED_MISSING_TOOL", "gofmt 不在 PATH（Go 侧可解析前置缺件）⇒ rc=2")
        res = run_clocked([gofmt, "-e", target], ctx.cfg["clock"])
        if res["timeout"]:
            raise Blocked("BLOCKED_TIMEOUT", "`gofmt -e` 超时（%ds）⇒ 不给结论" % ctx.cfg["clock"])
        if res["rc"] != 0:
            raise Blocked("BLOCKED_UNPARSABLE",
                          "可解析前置不过：`gofmt -e %s` rc=%d ⇒ 目标**语法/形态不合法** ⇒ 不给结论"
                          "（M7：不可解析与零命中同形，不许当成「锚点没命中」）"
                          % (target, res["rc"]), detail=res["err"].splitlines()[:4])
        return "gofmt -e（rc=0）"
    if ext == ".py":
        try:
            with open(target, "r", encoding="utf-8", errors="replace") as fh:
                ast.parse(fh.read(), filename=target)
        except SyntaxError as exc:
            raise Blocked("BLOCKED_UNPARSABLE",
                          "可解析前置不过：`ast.parse` SyntaxError（%s）⇒ 不给结论（M7）" % exc,
                          detail=[str(exc)])
        return "ast.parse（无 SyntaxError）"
    raise Blocked("BLOCKED_NO_PARSER",
                  "目标扩展名 %s 没有登记的解析前置（已登记：.go → `gofmt -e` · .py → `ast.parse`）⇒ "
                  "缺件被读成结论是本仓的老病（M7/M12）⇒ 不给结论" % (ext or "(无)"))


def locate(ctx, tool, rule, target):
    """E1 的定位调用：**写死** = `ast-grep scan -r <rule> --json <target>`，命中数 = 数组长度。"""
    argv = [tool["path"], "scan", "-r", rule["path"], "--json", target]
    res = run_clocked(argv, ctx.cfg["clock"])
    if res["timeout"]:
        raise Blocked("BLOCKED_TIMEOUT",
                      "定位调用超时（%ds）⇒ rc=2 不给结论（墙钟符已杀干净进程组）" % ctx.cfg["clock"])
    raw = res["out"].strip()
    try:
        arr = json.loads(raw) if raw else None
    except ValueError:
        arr = None
    if not isinstance(arr, list):
        raise Blocked("BLOCKED_SCAN_UNPARSEABLE",
                      "`scan --json` 的 stdout 不是 JSON 数组（工具失效不得被读成结果，J5）："
                      "rc=%r · stdout=%r · stderr=%r" % (res["rc"], res["out"][:200], res["err"][:200]))
    if ctx.inverted("E1_LOCATE_SCAN_JSON"):
        raise Failed("FAIL_E1_LOCATE",
                     "负控：E1_LOCATE_SCAN_JSON 被取反 ⇒ 定位证据作废（真实数组长度 %d 被判为不可信）"
                     % len(arr))
    line = ("   定位：%s ⇒ **scan rc=%s（一律不采信）** · `--json` 数组长度 = %d · 耗时 %.2fs"
            % (" ".join(shlex.quote(a) for a in argv), res["rc"], len(arr), res["elapsed"]))
    return arr, res, line


def hit_spans(data, arr):
    """把 JSON 里的 range 变成**字节区间**并逐条自证（文本逐字相等，否则不给结论）。"""
    out = []
    for h in arr:
        rng = h.get("range") or {}
        bo = rng.get("byteOffset") or {}
        txt = h.get("text") or ""
        s, e = bo.get("start"), bo.get("end")
        how, ok = "byteOffset", False
        if isinstance(s, int) and isinstance(e, int) and 0 <= s <= e <= len(data):
            if data[s:e] == txt.encode("utf-8"):
                ok = True
        if not ok:
            # 兜底：按「行/列（字符）」解释，并如实标注这次重解释（不静默）
            st, en = (rng.get("start") or {}), (rng.get("end") or {})
            if isinstance(st.get("line"), int) and isinstance(en.get("line"), int):
                text = data.decode("utf-8", "replace")
                lines = text.splitlines(True)
                if st["line"] < len(lines) and en["line"] < len(lines):
                    cs = sum(len(x) for x in lines[:st["line"]]) + st.get("column", 0)
                    ce = sum(len(x) for x in lines[:en["line"]]) + en.get("column", 0)
                    if text[cs:ce].encode("utf-8") == txt.encode("utf-8"):
                        bs = len(text[:cs].encode("utf-8"))
                        be = len(text[:ce].encode("utf-8"))
                        s, e, how, ok = bs, be, "行/列（已重解释为字节）", True
        if not ok:
            raise Blocked("BLOCKED_SCAN_UNPARSEABLE",
                          "scan 给的第 %d 处命中无法与文件字节对上（text=%r · byteOffset=%r）⇒ 不给结论"
                          % (len(out) + 1, txt[:60], bo))
        pos = (rng.get("start") or {})
        out.append({"start": s, "end": e, "text": txt, "how": how,
                    "line": (pos.get("line", 0) or 0) + 1, "column": (pos.get("column", 0) or 0) + 1,
                    "line_end": ((rng.get("end") or {}).get("line", 0) or 0) + 1})
    return out


# ══════════════════════════════════════════════════════════════════
# 6. 期望值与断言（§4.2 四形态）
# ══════════════════════════════════════════════════════════════════

def judge_expect(ctx, spec, hits):
    """E2：命中数断言。返回 (ok, code, msg)。**0 命中且期望 ≥1 ⇒ 红（不是 0、不是 2）**。"""
    form, expect, reason = spec["form"], spec["expect"], spec.get("reason")
    if ctx.inverted("E2_HIT_COUNT"):
        ok = (hits not in expect) if form == "集合" else (hits != expect)
        return (True, "OK_GREEN", "负控：E2_HIT_COUNT 取反 ⇒ 命中 %d 与期望 %s 的比较结论翻转（判过）"
                % (hits, expect)) if ok else \
               (False, "FAIL_HIT_MISMATCH", "负控：E2_HIT_COUNT 取反 ⇒ 命中 %d vs 期望 %s 判红" % (hits, expect))
    if ctx.inverted("E2_EXPECT_FROM_CALLER") and not reason:
        reason = "(负控：E2_EXPECT_FROM_CALLER 被取反 ⇒ 无理由也算过)"
    if form == "集合":
        ok = hits in expect
        why = "期望 ∈ {%s}（理由：%s）· 实际 %d" % (", ".join(str(x) for x in expect), reason, hits)
    else:
        ok = (hits == expect)
        why = "期望 %d（形态=%s；%s）· 实际 %d" % (
            expect, form, "理由：%s" % reason if reason else "**未给理由**", hits)
    if ok:
        return True, "OK_GREEN", why
    if hits == 0 and (expect != 0 if form != "集合" else (0 not in expect)):
        return False, "FAIL_HIT_ZERO", why + " ⇒ **0 命中 ⇒ 硬失败**（§4.1 铁律：门的第一颗牙）"
    return False, "FAIL_HIT_MISMATCH", why + " ⇒ 命中数 ∉ 期望 ⇒ 硬失败"


# ══════════════════════════════════════════════════════════════════
# 7. 五步（E1–E5）主流程
# ══════════════════════════════════════════════════════════════════

class Restorer(object):
    """写盘窗口的兜底：任何异常 ⇒ 按内存前像字节复原（C2「先复原再报」）。"""

    def __init__(self):
        self.active = None

    def arm(self, target, pre_bytes):
        self.active = (target, pre_bytes, sha256_bytes(pre_bytes))

    def disarm(self):
        self.active = None

    def restore(self):
        if not self.active:
            return None
        target, pre_bytes, pre_sha = self.active
        tmp = target + ".edit-assert-restore-%d" % os.getpid()
        with open(tmp, "wb") as fh:
            fh.write(pre_bytes)
            fh.flush()
            os.fsync(fh.fileno())
        os.replace(tmp, target)
        now = sha256_file(target)
        self.active = None
        return {"target": target, "pre_sha": pre_sha, "restored_sha": now, "ok": now == pre_sha}


def write_atomic(target, data):
    """E3 的落盘动作：同目录临时文件 + os.replace（原子替换）。"""
    tmp = target + ".edit-assert-%d.tmp" % os.getpid()
    fh = open(tmp, "wb")
    try:
        fh.write(data)
        fh.flush()
        os.fsync(fh.fileno())
    finally:
        fh.close()
    os.replace(tmp, target)


def ledger_row(ctx, spec, rule, tool, phase, pre_sha, post_sha, hits, status, reason_code, idem_ok,
               xform_key, run_id=None, hits2=None, extra=None):
    cfg = ctx.cfg
    row = {
        "ts": now_iso(),
        "run_id": run_id or uuid.uuid4().hex,
        "phase": phase,
        "actor": cfg["actor"],
        "role": cfg["role"],
        "gate_id": "edit-assert/%s" % VERSION,
        "target": os.path.abspath(spec["target"]),
        "rule": rule["path"],
        "rule_sha256": rule["sha256"],
        "expect": spec["expect"],
        "expect_form": spec["form"],
        "reason": spec.get("reason"),
        "hits": hits,
        "hits2": hits2,
        "pre_sha": pre_sha,
        "post_sha": post_sha,
        "status": status,
        "reason_code": reason_code,
        "idem_ok": idem_ok,
        "xform_key": xform_key,
        "tool": "ast-grep",
        "tool_version": tool["version"] if tool else None,
        "tool_binary_sha256": tool["sha256"] if tool else None,
        "cmd": "ast-grep scan -r %s --json %s" % (rule["path"], spec["target"]),
        "match_level": "L-AST（scan -r --json）",
        "sandbox_root": cfg.get("sandbox_root"),
        "cwd": os.getcwd(),
    }
    if extra:
        row.update(extra)
    return row


def xform_key_for(spec, rule):
    return sha256_bytes(("%s|%s|%s|%s|%s|%s" % (
        os.path.abspath(spec["target"]), rule["sha256"], spec["form"], spec["expect"],
        spec.get("replace_from") or "", spec.get("replace_to") or "")).encode("utf-8"))


def run_one_target(ctx, tool, rule, spec, ledger, restorer, idx, total):
    """一个目标的 E1–E5。"""
    target = spec["target"]
    cfg = ctx.cfg
    ctx.say("")
    ctx.say("══ [%d/%d] %s ══" % (idx, total, target))
    if not os.path.isfile(target):
        raise Blocked("BLOCKED_MISSING_TARGET", "目标文件不存在：%s" % target)

    parser = parse_precheck(ctx, target)
    ctx.say("── ② 缺件检查 ✓（工具在 · 规则在 · 目标在）── ③ 可解析前置（M7）：%s ⇒ ✓ 可解析" % parser)

    data = read_bytes(target)
    pre_sha = sha256_bytes(data)

    # ── E1 dry-run ───────────────────────────────────────────────
    ctx.say("── E1 dry-run（只读预览，**不写盘**）──")
    ctx.say("   规则：%s（sha256=%s）· 目标：%s（sha256=%s）"
            % (rule["path"], rule["sha256"][:16], target, pre_sha[:16]))
    arr, _res, line = locate(ctx, tool, rule, target)
    ctx.say(line)
    spans = hit_spans(data, arr)
    hits = len(spans)
    for i, sp in enumerate(spans, 1):
        ctx.say("   命中 %d/%d：%s:%d:%d（行 %d–%d）· 文本 %r"
                % (i, hits, target, sp["line"], sp["column"], sp["line"], sp["line_end"], sp["text"][:80]))
    if not spans:
        ctx.say("   （零命中：stdout 逐字 %r —— 与「目标语法错」同形，故才有 ③ 那一步，M7）" % "[]")

    xkey = xform_key_for(spec, rule)
    replay = ledger.find_replay(xkey) if cfg["write"] else None
    is_replay = bool(replay and replay.get("post_sha") == pre_sha)
    if is_replay:
        ctx.say("── 幂等复跑判定（E5 · 台账）──")
        ctx.say("   台账查到同一变换已收尾：run_id=%s · post_sha=%s == 当前 sha256 ⇒ **本跑是幂等复跑**，"
                "期望 0 命中" % (replay.get("run_id"), pre_sha[:16]))

    # ── E2 ──────────────────────────────────────────────────────
    ctx.say("── E2 命中数断言（形态=%s）──" % spec["form"])
    if is_replay:
        ok = (hits == 0)
        code = "OK_IDEMPOTENT" if ok else "FAIL_NOT_IDEMPOTENT"
        msg = "二次跑命中 %d（期望 0）⇒ %s" % (hits, "零改动 ⇒ 幂等 ✓" if ok else "**又改了** ⇒ 不只做一件事")
        ctx.say("   " + msg)
        # 幂等复跑同样留痕：一组 begin/end（E5 的判据也要可审计 ⇒ 「台账四行」= 两跑各两行）
        rb = ledger.append(ledger_row(ctx, spec, rule, tool, "begin", pre_sha, None, hits, "BEGIN",
                                      "BEGIN", None, xkey, extra={"replay_of": replay.get("run_id")}))
        re_ = ledger.append(ledger_row(ctx, spec, rule, tool, "end", pre_sha, pre_sha, hits, code, code,
                                       ok, xkey, run_id=rb["run_id"], hits2=hits,
                                       extra={"replay_of": replay.get("run_id")}))
        ctx.say("   幂等复跑也留痕：begin/end 各一行（run_id=%s · status=%s · idem_ok=%s）"
                % (re_["run_id"], code, ok))
        return {"target": target, "hits": hits, "hits2": hits, "pre_sha": pre_sha, "post_sha": pre_sha,
                "code": code, "msg": msg, "idem_ok": ok}
    if spec["form"] == "集合" and not spec.get("reason"):
        raise Blocked("BLOCKED_USAGE", "集合形态必须显式给 --reason（§4.2：必须能回答「为什么是 N」）")
    ok, code, msg = judge_expect(ctx, spec, hits)
    ctx.say("   " + msg)
    if not ok:
        ctx.say("   ⇒ %s（rc=1）" % code)
        return {"target": target, "hits": hits, "hits2": None, "pre_sha": pre_sha, "post_sha": pre_sha,
                "code": code, "msg": msg, "idem_ok": None}
    if not cfg["write"]:
        ctx.say("   ⇒ 只读预览通过（未写盘 ⇒ 无 begin/end 台账行：台账只记**写盘**动作，§7.4）")
        return {"target": target, "hits": hits, "hits2": None, "pre_sha": pre_sha, "post_sha": pre_sha,
                "code": "OK_DRYRUN", "msg": msg, "idem_ok": None}
    if hits == 0:
        ctx.say("   ⇒ 期望 0 且实际 0：**无命中可改** ⇒ 跳过 E3/E4，E5 无事可做（零改动）")
        return {"target": target, "hits": 0, "hits2": 0, "pre_sha": pre_sha, "post_sha": pre_sha,
                "code": "OK_GREEN", "msg": "期望 0 命中、零改动（不写盘）", "idem_ok": True}

    # ── E3 写盘（任何异常都必须 close 掉 begin 行，否则下次启动会判未收尾）──
    closed = {"done": False, "begin": None}

    def closer(code, idem, post_sha):
        if closed["begin"] is not None and not closed["done"]:
            closed["done"] = True
            row = ledger.append(ledger_row(ctx, spec, rule, tool, "end", pre_sha, post_sha, hits,
                                           code, code, idem, closed["begin"]["xform_key"],
                                           run_id=closed["begin"]["run_id"], hits2=None))
            ctx.say("   end 行已落台账：run_id=%s · status=%s · reason_code=%s · idem_ok=%s"
                    % (row["run_id"], code, code, idem))

    try:
        ctx.say("── E3 写盘（原子替换 os.replace）──")
        if ctx.inverted("E3_PRE_SHA"):
            raise Failed("FAIL_NEG_INVERTED", "负控：E3_PRE_SHA 被取反 ⇒ 前像登记作废 ⇒ 禁止写盘")
        rf, rt = spec.get("replace_from"), spec.get("replace_to")
        if rf is None or rt is None:
            raise Blocked("BLOCKED_USAGE",
                          "写盘形态必须给 `--replace-from` 与 `--replace-to`（否则门不知道写什么）")
        bad = [s for s in spans if data[s["start"]:s["end"]] != rf.encode("utf-8")]
        if bad:
            raise Failed("FAIL_REPLACE_MISMATCH",
                         "命中文本 ≠ --replace-from（%d/%d 处不符）⇒ **写盘前拦下，零改动**"
                         "（对齐 tool-upgrade.md:227）" % (len(bad), len(spans)),
                         detail=["实际 %r / 声明 %r" % (s["text"][:60], rf[:60]) for s in bad][:3])
        out = bytearray(data)
        for sp in sorted(spans, key=lambda s: s["start"], reverse=True):
            out[sp["start"]:sp["end"]] = rt.encode("utf-8")
        new = bytes(out)
        if new == data:
            raise Failed("FAIL_NO_CHANGE", "替换后字节未变（--replace-to 与 --replace-from 等价）⇒ 失败")
        closed["begin"] = ledger.append(ledger_row(
            ctx, spec, rule, tool, "begin", pre_sha, None, hits, "BEGIN", "BEGIN", None, xkey,
            extra={"replace_from": rf, "replace_to": rt}))
        restorer.arm(target, data)
        try:
            write_atomic(target, new)
        except (IOError, OSError) as exc:
            raise Blocked("BLOCKED_WRITE_ABORTED", "写盘失败（%s）⇒ 已按前像字节复原" % exc)
        post_sha = sha256_file(target)
        ctx.say("   前像 sha256=%s · begin 行已落台账（run_id=%s）" % (pre_sha, closed["begin"]["run_id"]))
        ctx.say("   原子替换：临时文件 + os.replace ⇒ 后像 sha256=%s" % post_sha)
        if ctx.inverted("E3_ATOMIC_REPLACE"):
            raise Failed("FAIL_NEG_INVERTED", "负控：E3_ATOMIC_REPLACE 被取反 ⇒ 写盘证据作废")

        # ── E4 diff 复核 ─────────────────────────────────────────
        ctx.say("── E4 diff 复核（只读；门内 git 只允许 diff/status/rev-parse）──")
        pre_lines = data.decode("utf-8", "replace").splitlines()
        post_lines = new.decode("utf-8", "replace").splitlines()
        changed = set()
        for op in difflib.SequenceMatcher(None, pre_lines, post_lines).get_opcodes():
            if op[0] == "equal":
                continue
            for ln in range(op[1], op[2]):
                changed.add(ln + 1)
            if op[1] == op[2]:
                changed.add(max(op[1], 1))
        hit_lines = set()
        for sp in spans:
            for ln in range(sp["line"], sp["line_end"] + 1):
                hit_lines.add(ln)
        superset = sorted(changed - hit_lines)
        ctx.say("   实际改动行=%s ⊆ E1 报告集合=%s ⇒ %s"
                % (sorted(changed), sorted(hit_lines), "✓" if not superset else "✗ 多出 %s" % superset))
        pc, cursor = [], 0
        for sp in sorted(spans, key=lambda s: s["start"]):
            pc.append(data[cursor:sp["start"]])
            cursor = sp["end"]
        pc.append(data[cursor:])
        outside_pre = b"".join(pc)
        pc2, cursor2, shift = [], 0, 0
        for sp in sorted(spans, key=lambda s: s["start"]):
            s2, e2 = sp["start"] + shift, sp["end"] + shift
            pc2.append(new[cursor2:s2])
            cursor2 = e2
            shift += len(rt.encode("utf-8")) - (sp["end"] - sp["start"])
        pc2.append(new[cursor2:])
        outside_post = b"".join(pc2)
        outside_ok = (outside_pre == outside_post)
        ctx.say("   命中范围外逐字节比对：%s（%d vs %d 字节）"
                % ("✓ 未变" if outside_ok else "✗ **命中范围外也变了**", len(outside_pre), len(outside_post)))
        gline = git_diff_note(ctx, target)
        if gline:
            ctx.say("   %s" % gline)
        if superset or not outside_ok or ctx.inverted("E4_DIFF_SUBSET"):
            raise Failed("FAIL_DIFF_SUPERSET",
                         "实际改动集 ⊄ E1 报告集合（多出 %s / 范围外变更=%s）⇒ 失败（多一行即失败，§2.2 E4）"
                         % (superset or "无", not outside_ok))
        if ctx.inverted("E4_GIT_READONLY"):
            raise Failed("FAIL_NEG_INVERTED", "负控：E4_GIT_READONLY 被取反 ⇒ git 只读断言失败")

        # ── E5 幂等二次跑 ────────────────────────────────────────
        ctx.say("── E5 幂等二次跑（同一命令再跑一遍 · dry-run 形态）──")
        arr2, _r2, _l2 = locate(ctx, tool, rule, target)
        hits2 = len(arr2)
        sha_now = sha256_file(target)
        ctx.say("   二次定位命中 %d（期望 0）· 目标 sha256=%s（%s）"
                % (hits2, sha_now[:16], "与后像一致" if sha_now == post_sha else "**又变了**"))
        idem_ok = (hits2 == 0) and (sha_now == post_sha)
        if ctx.inverted("E5_IDEMPOTENT"):
            idem_ok = not idem_ok
        if not idem_ok:
            raise Failed("FAIL_NOT_IDEMPOTENT",
                         "二次跑仍有命中（%d）或目标又变了 ⇒ 这条命令不只做一件事（M3/E5）" % hits2)
        ctx.say("   ⇒ ✓ 幂等：零命中 + 零字节变化")
        restorer.disarm()
        closer("OK_GREEN", True, post_sha)
        return {"target": target, "hits": hits, "hits2": hits2, "pre_sha": pre_sha, "post_sha": post_sha,
                "code": "OK_GREEN", "msg": "E1–E5 全过", "idem_ok": True}
    except (Blocked, Failed) as exc:
        fixed = restorer.restore()
        if fixed:
            ctx.say("   ⚠ 写盘窗口内异常 ⇒ **已按前像字节复原**：%s sha256=%s（%s）"
                    % (fixed["target"], fixed["restored_sha"][:16],
                       "与前像一致 ✓" if fixed["ok"] else "**仍不一致 ✗**"))
        # 台账 end 行记「现在的实际状态」（复原后 = 前像 sha），便于事后对账
        now_sha = sha256_file(target) if os.path.isfile(target) else None
        closer(exc.code, False, now_sha)
        exc.hits = hits
        exc.pre_sha = pre_sha
        exc.post_sha = locals().get("post_sha")
        if isinstance(exc, Blocked):
            raise
        raise


def git_diff_note(ctx, target):
    """E4 的 git 侧（只读；跑不起来 ⇒ 显式注记，不静默降级）。"""
    cfg = ctx.cfg
    if cfg.get("diff_cmd"):
        argv = shlex.split(cfg["diff_cmd"]) + [os.path.abspath(target)]
        res = run_clocked(argv, cfg["clock"])
        if res["timeout"]:
            raise Blocked("BLOCKED_TIMEOUT", "E4 的外部命令超时（%ds ⇒ 已杀进程组）⇒ 不给结论：%s"
                          % (cfg["clock"], " ".join(argv)))
        return "diff 命令（--diff-cmd 覆盖）：%s ⇒ rc=%s · 输出 %d 字节 · 耗时 %.2fs" % (
            " ".join(argv), res["rc"], len(res["out"]), res["elapsed"])
    if shutil.which("git") is None:
        raise Blocked("BLOCKED_MISSING_TOOL", "E4 需要 git（只读 diff），但 git 不在 PATH ⇒ rc=2（§6.3）")
    d = os.path.dirname(os.path.abspath(target))
    argv = ["git", "diff", "-U0", "--", os.path.basename(target)]
    res = run_clocked(argv, cfg["clock"], cwd=d)
    if res["timeout"]:
        raise Blocked("BLOCKED_TIMEOUT", "`git diff` 超时（%ds）⇒ 不给结论" % cfg["clock"])
    if res["rc"] != 0:
        ctx.warn("WARN_GIT_SKIPPED",
                 "git diff 跑不起来（rc=%s：目标不在 git 仓内或未跟踪）⇒ E4 的 git 侧跳过，"
                 "判据由「前后像逐行 + 命中范围外逐字节」顶上" % res["rc"])
        return None
    tail = [l for l in res["out"].splitlines() if l.startswith("@@") or l.startswith("+") or l.startswith("-")]
    if not tail:
        ctx.warn("WARN_GIT_SKIPPED", "git diff 无输出（目标未被 git 跟踪）⇒ E4 的 git 侧跳过")
        return None
    return "git diff（只读 -U0）：%s" % (" / ".join(tail[:4])[:220])


# ══════════════════════════════════════════════════════════════════
# 8. 门（多目标遍历 + 汇总）
# ══════════════════════════════════════════════════════════════════

def gate(ctx, specs):
    cfg = ctx.cfg
    ledger = Ledger(ctx)
    restorer = Restorer()
    ctx.say("════════════════════════════════════════════════════════════════")
    ctx.say("edit-assert %s — 凡写盘，必过一门（腿二五步 E1–E5 · 判据 J1–J6）" % VERSION)
    ctx.say("仓根：%s" % REPO_ROOT)
    ctx.say("形态：%s · actor=%s · role=%s · 墙钟上界=%ds"
            % ("**真写盘**" if cfg["write"] else "只读预览 dry-run（不写盘）", cfg["actor"], cfg["role"],
               cfg["clock"]))
    if ctx.neg:
        ctx.say("★ 负控形态：被点名的断言 %s **已取反**（本跑**不是**正常判定）" % " · ".join(sorted(ctx.neg)))
    ctx.say("前置顺序（写死 · J4）：① 台账（路径/可写/未收尾）→ ② 缺件（工具/规则/目标）→ "
            "③ 可解析（gofmt -e / ast.parse）→ ④ 命中数断言")
    try:
        ledger.startup()
        tool = resolve_ast_grep(ctx)
        rules = {}
        for spec in specs:
            if spec["rule"] not in rules:
                rules[spec["rule"]] = load_rule(ctx, spec["rule"])
        ctx.say("── ② 缺件检查 ── ast-grep 在（%s）· 规则 %d 件在 · 目标 %d 件在"
                % (tool["path"], len(rules), len(specs)))
        results = []
        for i, spec in enumerate(specs, 1):
            try:
                results.append(run_one_target(ctx, tool, rules[spec["rule"]], spec, ledger, restorer, i,
                                              len(specs)))
            except (Blocked, Failed) as exc:
                for d in exc.detail:
                    ctx.say("      | %s" % d)
                ctx.say("✗ [%s] %s" % (exc.code, exc.msg))
                results.append({"target": spec["target"], "code": exc.code, "msg": exc.msg,
                                "kind": type(exc).__name__,
                                "pre_sha": getattr(exc, "pre_sha", None),
                                "post_sha": getattr(exc, "post_sha", None),
                                "hits": getattr(exc, "hits", None), "hits2": None, "idem_ok": None})
                break
        return summarize(ctx, results, ledger)
    except (Blocked, Failed) as exc:
        fixed = restorer.restore()
        if fixed:
            ctx.say("   ⚠ 异常在写盘窗口内 ⇒ 已复原：%s sha256=%s" % (fixed["target"], fixed["restored_sha"]))
        ctx.say("")
        ctx.say("✗ [%s] %s" % (exc.code, exc.msg))
        for d in exc.detail:
            ctx.say("      | %s" % d)
        ctx.say("结论：rc=2 **不给结论**（原因码 %s —— %s）" % (exc.code, REASON_DESC.get(exc.code, "")))
        return EXIT_BLOCKED


def summarize(ctx, results, ledger):
    ctx.say("")
    ctx.say("════════════════════════════════════════════════════════════════")
    ctx.say("── 逐目标结论 ──")
    nfail, nblocked = 0, 0
    for r in results:
        code = r["code"]
        tier = REASON_TIER.get(code, EXIT_FAIL)
        mark = {0: "✓ 绿", 1: "✗ 红", 2: "■ 不给结论"}.get(tier, "?")
        ctx.say("  %s %-38s hits=%s/%s pre=%s post=%s · %s"
                % (mark, os.path.basename(r["target"]), r.get("hits"), r.get("hits2"),
                   (r.get("pre_sha") or "-")[:12], (r.get("post_sha") or "-")[:12], code))
        if r.get("msg"):
            ctx.say("      ↳ %s" % r["msg"])
        if tier == 1:
            nfail += 1
        elif tier == 2:
            nblocked += 1
    if ctx.warnings:
        ctx.say("── 警告（不阻断，但**不静默**）──")
        for w in ctx.warnings:
            ctx.say("  ⚠ [%s] %s" % (w["code"], w["msg"]))
    ctx.say("  台账：%s（来源 %s）· 现有行数 %d" % (ledger.path, ledger.source, ledger.line_count()))
    if nblocked:
        codes = [r["code"] for r in results if REASON_TIER.get(r["code"]) == EXIT_BLOCKED]
        ctx.say("结论：rc=2 **不给结论**（%d 个目标前置不足：%s）" % (nblocked, " · ".join(codes)))
        return EXIT_BLOCKED
    if nfail or len(results) != ctx.cfg.get("n_targets", 1):
        codes = [r["code"] for r in results if REASON_TIER.get(r["code"]) == EXIT_FAIL]
        if len(results) != ctx.cfg.get("n_targets", 1):
            codes.append("FAIL_GROUP_PARTIAL")
        ctx.say("结论：rc=1（失败：%s）" % " · ".join(codes))
        return EXIT_FAIL
    only_idem = all(r["code"] == "OK_IDEMPOTENT" for r in results)
    ctx.say("结论：rc=0（%s）" % ("幂等复跑零改动（OK_IDEMPOTENT）" if only_idem else "E1–E5 全过（OK_GREEN）"))
    return EXIT_OK


# ══════════════════════════════════════════════════════════════════
# 9. 自检夹具 + 子进程入口
# ══════════════════════════════════════════════════════════════════

def make_fixture(root):
    """合成夹具（**不碰真目标**）：合法 Go + 真规则 + 语法错 + 零命中。"""
    fx = os.path.join(root, "fx")
    os.makedirs(fx)
    files = {
        "fixture.go": FIXTURE_GO,
        "rv.yml": FIXTURE_RULE,
        "rv_no_stopby.yml": FIXTURE_RULE.replace("    stopBy: end\n", ""),
        "rv_no_field.yml": FIXTURE_RULE.replace("      field: name\n", ""),
        "bad.go": FIXTURE_BAD_GO,
        "nomatch.go": FIXTURE_NOMATCH_GO,
    }
    for name, text in files.items():
        with open(os.path.join(fx, name), "w", encoding="utf-8") as fh:
            fh.write(text)
    return fx


def sub_run(args, state_dir=None, env_extra=None, path_override=None, timeout=300):
    """跑**真命令行**（自己 → 自己）；默认带 --no-self-test 防递归。返回 (rc, out)。"""
    env = dict(os.environ)
    env["EDIT_ASSERT_CHILD"] = "1"
    if state_dir:
        env["ZERG_STATE_DIR"] = state_dir
    if path_override is not None:
        env["PATH"] = path_override
    if env_extra:
        env.update(env_extra)
    argv = [sys.executable, SELF, "--no-self-test"] + list(args)
    try:
        proc = subprocess.Popen(argv, env=env, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
        out = proc.communicate(timeout=timeout)[0].decode("utf-8", "replace")
        return proc.returncode, out
    except subprocess.TimeoutExpired:
        proc.kill()
        return 99, "(子进程 %ds 未结束 ⇒ 自检判死)" % timeout
    except (IOError, OSError) as exc:
        return 99, "子进程起不来：%s" % exc


def reason_of(out):
    for code, tier in sorted(REASON_TIER.items(), key=lambda kv: kv[1], reverse=True):
        if "[%s]" % code in (out or "") or "\"%s\"" % code in (out or ""):
            return code
    for code in REASON_TIER:
        if code in (out or ""):
            return code
    return None


# ══════════════════════════════════════════════════════════════════
# 10. 自检（--self-test）：自身先自证，不过则拒绝跑真目标
# ══════════════════════════════════════════════════════════════════

def run_self_test():
    root = os.path.join(os.environ.get("TMPDIR", "/tmp"), "edit-assert-selftest-%s" % uuid.uuid4().hex[:8])
    os.makedirs(root)
    fx = make_fixture(root)
    state = os.path.join(root, "state")
    os.makedirs(state)
    ledger = os.path.join(state, LEDGER_NAME)
    shutil.copyfile(os.path.join(fx, "rv.yml"), os.path.join(fx, "rv.yml.bak"))
    checks = []

    def add(name, ok, note, out=""):
        checks.append((name, ok, note, out))

    def run(args, **kw):
        return sub_run(args, state_dir=state, **kw)

    print("════════════════════════════════════════════════════════════════")
    print("edit-assert %s 自检（合成夹具 · **不碰真目标** · 台账钉在 %s）" % (VERSION, state))
    print("夹具：%s" % fx)

    # T1 定位三态的真实证据（rc 一律不采信）
    tri = []
    tool_path = shutil.which("ast-grep")
    if not tool_path:
        add("T1 [E1_LOCATE_SCAN_JSON] `scan` 三态 rc 全 0 ⇒ 工具 rc 不可作判据；数组长度才是命中数",
            False, "ast-grep 不在本 PATH ⇒ 自检夹具无法建立（这是缺件，不是判定）")
    else:
        for tgt in ("fixture.go", "nomatch.go", "bad.go"):
            r = run_clocked([tool_path, "scan", "-r", os.path.join(fx, "rv.yml"), "--json",
                             os.path.join(fx, tgt)], 60)
            try:
                n = len(json.loads(r["out"]))
            except ValueError:
                n = None
            tri.append((tgt, r["rc"], n))
        add("T1 [E1_LOCATE_SCAN_JSON] `scan` 三态 rc 全 0 ⇒ 工具 rc 不可作判据；数组长度才是命中数",
            tri[0][1] == 0 and tri[1][1] == 0 and tri[2][1] == 0 and
            (tri[0][2], tri[1][2], tri[2][2]) == (1, 0, 0),
            "三态实测 " + " · ".join("%s: rc=%s 数组=%s" % t for t in tri))

    rv = os.path.join(fx, "rv.yml")
    fxgo = os.path.join(fx, "fixture.go")

    # T2 零命中 + 期望 1 ⇒ rc=1（门的第一颗牙）
    rc, out = run(["--rule", rv, "--target", os.path.join(fx, "nomatch.go"), "--ledger-path", ledger,
                   "--expect", "1", "--reason", "自检：故意零命中"])
    add("T2 [E2_HIT_COUNT] 零命中 + 期望 1 ⇒ rc=1（**不是 0、不是 2**，FAIL_HIT_ZERO）",
        rc == 1 and "FAIL_HIT_ZERO" in out, "rc=%d 原因码=%s" % (rc, reason_of(out)), out)

    # T3 命中 1 + 期望 2 ⇒ rc=1
    rc, out = run(["--rule", rv, "--target", fxgo, "--ledger-path", ledger, "--expect", "2",
                   "--reason", "自检：故意不匹配"])
    add("T3 [E2_HIT_COUNT] 命中 1 + 期望 2 ⇒ rc=1（FAIL_HIT_MISMATCH）",
        rc == 1 and "FAIL_HIT_MISMATCH" in out, "rc=%d 原因码=%s" % (rc, reason_of(out)), out)

    # T4 四形态正例
    sub, outs = [], []
    for label, args in (("精确", ["--expect", "1", "--reason", "精确形态"]), ("唯一", ["--unique"]),
                        ("集合", ["--set", "1,2", "--reason", "集合形态：重构前后都合法"])):
        rc, out = run(["--rule", rv, "--target", fxgo, "--ledger-path", ledger] + args)
        sub.append((label, rc))
        outs.append(out)
    grp = os.path.join(fx, "group.json")
    with open(grp, "w", encoding="utf-8") as fh:
        json.dump({"assertions": [
            {"name": "g1", "rule": rv, "target": fxgo, "expect": 1, "reason": "只改这一处"},
            {"name": "g2", "rule": rv, "target": os.path.join(fx, "nomatch.go"), "expect": 0,
             "reason": "这处不许被动到"},
        ]}, fh, ensure_ascii=False)
    rc, out = run(["--group", grp, "--ledger-path", ledger])
    sub.append(("一组", rc))
    outs.append(out)
    add("T4 [E2_HIT_COUNT] 四种断言形态（精确/唯一/集合/一组）正例 ⇒ 全 rc=0",
        all(s[1] == 0 for s in sub), " · ".join("%s rc=%d" % s for s in sub), "\n".join(outs[:1]))

    # T5 缺件优先于不可解析（D4 顺序坑）
    rc, out = run(["--rule", rv, "--target", os.path.join(fx, "bad.go"), "--expect", "1",
                   "--ledger-path", ledger], path_override="/usr/bin:/bin")
    add("T5 [PRE_ORDER] PATH 里没有 ast-grep + 目标**语法错** ⇒ 报缺件（BLOCKED_MISSING_TOOL）"
        "而**不是**不可解析（D4 顺序坑）",
        rc == 2 and "BLOCKED_MISSING_TOOL" in out and "BLOCKED_UNPARSABLE" not in out,
        "rc=%d 原因码=%s" % (rc, reason_of(out)), out)

    # T6 真 ast-grep 在位 + 语法错目标 ⇒ 不可解析
    rc, out = run(["--rule", rv, "--target", os.path.join(fx, "bad.go"), "--expect", "1",
                   "--ledger-path", ledger])
    add("T6 [PRE_PARSE] 真 ast-grep 在位 + 语法错目标 ⇒ rc=2 BLOCKED_UNPARSABLE（`gofmt -e` rc≠0）",
        rc == 2 and "BLOCKED_UNPARSABLE" in out, "rc=%d 原因码=%s" % (rc, reason_of(out)), out)

    # T7 规则缺 stopBy ⇒ rc=2
    rc, out = run(["--rule", os.path.join(fx, "rv_no_stopby.yml"), "--target", fxgo, "--expect", "1",
                   "--ledger-path", ledger])
    add("T7 [RULE_SCOPE] 规则缺 `stopBy: end` ⇒ rc=2 BLOCKED_RULE_SCOPE（默认 neighbor = 静默零命中）",
        rc == 2 and "BLOCKED_RULE_SCOPE" in out, "rc=%d 原因码=%s" % (rc, reason_of(out)), out)

    # T8 has 缺 field ⇒ 告警但不阻断
    rc, out = run(["--rule", os.path.join(fx, "rv_no_field.yml"), "--target", fxgo, "--expect", "1",
                   "--ledger-path", ledger])
    add("T8 [WARN_RULE_FIELD] 规则 `has:` 缺 `field:` ⇒ 不阻断但打告警（rc=0 + WARN 行）",
        rc == 0 and "WARN_RULE_FIELD" in out, "rc=%d 含 WARN=%s" % (rc, "WARN_RULE_FIELD" in out), out)

    # T9 写盘 + 幂等复跑（E3/E4/E5 + 台账 2× begin/end）
    copy = os.path.join(fx, "copy.go")
    shutil.copyfile(fxgo, copy)
    args = ["--rule", rv, "--target", copy, "--ledger-path", ledger, "--expect", "1",
            "--reason", "自检写盘", "--write", "--replace-from", FIXTURE_FROM, "--replace-to", FIXTURE_TO]
    sha0 = sha256_file(copy)
    rc1, out1 = run(args)
    sha1 = sha256_file(copy)
    rc2, out2 = run(args)
    sha2 = sha256_file(copy)
    rows = [json.loads(l) for l in open(ledger, "r", encoding="utf-8").read().splitlines() if l.strip()]
    pairs = (sum(1 for r in rows if r.get("phase") == "begin"), sum(1 for r in rows if r.get("phase") == "end"))
    add("T9 [E3/E5] 写盘 rc=0 · 幂等复跑 rc=0 且目标 sha256 不变 · 台账 begin/end 各 2 行",
        rc1 == 0 and rc2 == 0 and sha1 != sha0 and sha2 == sha1 and pairs == (2, 2),
        "首跑 rc=%d 复跑 rc=%d · 首跑后 sha 变了=%s · 复跑后 sha 不变=%s · 台账 begin=%d end=%d"
        % (rc1, rc2, sha1 != sha0, sha2 == sha1, pairs[0], pairs[1]),
        out1[-600:] + "\n--- 复跑 ---\n" + out2[-300:])

    # T10 命中文本与 --replace-from 不符 ⇒ rc=1 且零改动
    copy2 = os.path.join(fx, "copy2.go")
    shutil.copyfile(fxgo, copy2)
    sha_a = sha256_file(copy2)
    rc, out = run(["--rule", rv, "--target", copy2, "--ledger-path", ledger, "--expect", "1", "--write",
                   "--replace-from", "return outcome == WRONG", "--replace-to", FIXTURE_TO])
    add("T10 [E3_PRE_SHA] 命中文本 ≠ --replace-from ⇒ rc=1 且**目标 sha256 不变**（写盘前拦下）",
        rc == 1 and "FAIL_REPLACE_MISMATCH" in out and sha256_file(copy2) == sha_a,
        "rc=%d 原因码=%s · sha 未变=%s" % (rc, reason_of(out), sha256_file(copy2) == sha_a), out)

    # T11 未收尾检测
    l2 = os.path.join(state, "unfinished.jsonl")
    with open(l2, "w", encoding="utf-8") as fh:
        fh.write(json.dumps({"ts": now_iso(), "run_id": "deadbeef", "phase": "begin", "actor": "自检",
                             "target": copy2, "pre_sha": sha_a, "status": "BEGIN"}, ensure_ascii=False) + "\n")
    rc, out = run(["--rule", rv, "--target", fxgo, "--expect", "1", "--ledger-path", l2])
    add("T11 [LEDGER_UNFINISHED] 台账有 begin 无 end ⇒ rc=2 BLOCKED_UNFINISHED + 打印残留路径与当前 sha256",
        rc == 2 and "BLOCKED_UNFINISHED" in out and copy2 in out and sha_a[:16] in out,
        "rc=%d 原因码=%s" % (rc, reason_of(out)), out)

    # T12 墙钟符（拿 sleep 当外部命令；写盘后超时 ⇒ 先复原再报）
    copy3 = os.path.join(fx, "copy3.go")
    shutil.copyfile(fxgo, copy3)
    sha_b = sha256_file(copy3)
    t0 = time.time()
    rc, out = run(["--rule", rv, "--target", copy3, "--ledger-path", ledger, "--expect", "1", "--write",
                   "--replace-from", FIXTURE_FROM, "--replace-to", FIXTURE_TO, "--clock", "3",
                   "--diff-cmd", 'python3 -c "import time;time.sleep(30)"'])
    el = time.time() - t0
    add("T12 [CLOCK] 外部命令睡 30s + 上界 3s ⇒ rc=2 BLOCKED_TIMEOUT 且**不挂死**、目标已复原",
        rc == 2 and "BLOCKED_TIMEOUT" in out and el < 25 and sha256_file(copy3) == sha_b,
        "rc=%d 真实墙钟 %.1fs（上界 3s）· 原因码=%s · 目标 sha 复原=%s"
        % (rc, el, reason_of(out), sha256_file(copy3) == sha_b), out[-600:])

    # T13 负控坏名 ⇒ rc=2
    rc, out = sub_run(["--neg-control=NOT_A_NAME"], state_dir=state)
    add("T13 [J1] 负控给不存在的断言名 ⇒ rc=2 BLOCKED_NEGCONTROL_NAME",
        rc == 2 and "BLOCKED_NEGCONTROL_NAME" in out, "rc=%d 原因码=%s" % (rc, reason_of(out)), out)

    # T14 默认落点不退化到 /tmp
    home = os.path.join(root, "home")
    os.makedirs(home)
    rc, out = sub_run(["--rule", rv, "--target", fxgo, "--expect", "1", "--reason", "落点自检"],
                      env_extra={"HOME": home, "ZERG_STATE_DIR": ""})
    want = os.path.join(home, ".zerg", "state", LEDGER_NAME)
    add("T14 [LEDGER_PATH_REAL] 没有 ZERG_STATE_DIR 时落 ~/.zerg/state（**不退化到 /tmp**）",
        os.path.isfile(want), "期望落点=%s · 存在=%s · rc=%d" % (want, os.path.isfile(want), rc), out[:400])

    # T15 用法错 ⇒ rc=2
    rc, out = sub_run([], state_dir=state)
    add("T15 用法错（无参数）⇒ rc=2 BLOCKED_USAGE", rc == 2 and "BLOCKED_USAGE" in out, "rc=%d" % rc, out)

    # T16 台账 append-only（dry-run 不落行）
    n_before = len([l for l in open(ledger, "r", encoding="utf-8").read().splitlines() if l.strip()])
    rc, out = run(["--rule", rv, "--target", fxgo, "--ledger-path", ledger, "--expect", "1",
                   "--reason", "追加性自检"])
    n_after = len([l for l in open(ledger, "r", encoding="utf-8").read().splitlines() if l.strip()])
    add("T16 台账 append-only：dry-run 不落行、行数只增不减",
        n_after >= n_before and not os.path.exists(os.path.join(state, "tmp")),
        "%d → %d 行（dry-run 不落新行：%s）" % (n_before, n_after, n_after == n_before))

    bad = [c for c in checks if not c[1]]
    print("── 自检逐条（全部走**真实命令行 + 真实退出码**）──")
    for name, ok, note, out in checks:
        print("%s %s" % ("✓" if ok else "✗", name))
        print("      · %s" % note)
        if not ok:
            for ln in (out or "").splitlines()[-14:]:
                print("      | %s" % ln)
    print("── 自检结论：%s（用例 %d 条，失败 %d 条）──"
          % ("全过" if not bad else "不过", len(checks), len(bad)))
    shutil.rmtree(root, ignore_errors=True)
    if bad:
        print("✗ 自检不过 ⇒ **拒绝跑真目标**（rc=2；precommit-gates.sh:36 的项目口径）")
        return EXIT_BLOCKED
    return EXIT_OK


# ══════════════════════════════════════════════════════════════════
# 11. 负控（--neg-control=<断言名>）：成对 + 点名（§7.1 J1/J2）
# ══════════════════════════════════════════════════════════════════

def run_neg_control(name, cli_args):
    if name not in ASSERT_NAMES:
        print("✗ 断言名不存在：%r" % name)
        print("  已登记断言（%d 条）：%s" % (len(ASSERT_NAMES), " · ".join(ASSERT_NAMES)))
        print("✗ 结论：rc=2 **不给结论**（BLOCKED_NEGCONTROL_NAME —— §7.1 J1：坏名 rc=2）")
        return EXIT_BLOCKED
    desc = [a for a in ASSERTIONS if a[0] == name][0]
    print("════════════════════════════════════════════════════════════════")
    print("edit-assert %s 负控（成对 + 点名 · §7.1 J1/J2）" % VERSION)
    print("被点名的断言：[%s]" % name)
    print("  判什么：%s" % desc[1])
    print("  形态：%s" % desc[2])
    print("  取反后应发生：%s" % desc[3])

    root = os.path.join(os.environ.get("TMPDIR", "/tmp"), "edit-assert-neg-%s" % uuid.uuid4().hex[:8])
    os.makedirs(root)
    fx = make_fixture(root)
    state = os.path.join(root, "state")
    os.makedirs(state)
    ledger = os.path.join(state, LEDGER_NAME)
    if cli_args:
        use = list(cli_args)
        shown = "（用调用方给的目标）"
    else:
        use = ["--rule", os.path.join(fx, "rv.yml"), "--target", os.path.join(fx, "fixture.go"),
               "--expect", "1", "--reason", "负控夹具（真目标只读；夹具随用随建）"]
        shown = "（用门自带夹具：teamOutcomeOK 同形）"
    rc_normal, out_normal = sub_run(use + ["--ledger-path", ledger], state_dir=state)
    rc_inv, out_inv = sub_run(use + ["--ledger-path", ledger, "--neg=%s" % name], state_dir=state)
    print("── 形态① 正常（断言全开）%s ──" % shown)
    print("[%s] 正常形态 rc=%d" % (name, rc_normal))
    print("   结论行：%s" % (last_conclusion(out_normal) or "(无)"))
    print("── 形态② 负控（只把 [%s] 取反，其余断言不动）──" % name)
    print("[%s] 负控形态 rc=%d" % (name, rc_inv))
    print("   结论行：%s" % (last_conclusion(out_inv) or "(无)"))
    print("   原因码：%s" % (reason_of(out_inv) or "(命中断言全过 ⇒ 取反未生效)"))
    print("── 区分度（J2：**同一输入**，两条结论必须不同）──")
    proven = (rc_normal == 0) and (rc_inv != 0)
    print("   正常 rc=%d vs 取反 rc=%d ⇒ %s"
          % (rc_normal, rc_inv,
             "**不同** ✓ ⇒ 断言 [%s] 确实接在判定上（有牙齿）" % name if proven
             else "**相同** ✗ ⇒ 断言 [%s] 没接在判定上（拆不动）" % name))
    shutil.rmtree(root, ignore_errors=True)
    if not proven:
        print("✗ 负控不成立（取反后结论没翻转）⇒ rc=2 **不给结论**"
              "（BLOCKED_NEGCONTROL_NOTOOTH —— C11 禁「拆的和判的是同一段代码」的自我确认）")
        return EXIT_BLOCKED
    print("✓ 负控成立：正常 rc=0 / 负控形态 rc=%d（≠0 ✓；落在 1 档「有失败项」—— **负控不是绿**）" % rc_inv)
    print("结论：rc=1（OK_NEGCONTROL —— 负控**成立**；进程用非 0 档表明这不是一次通过，"
          "区分度证据见上面两行）")
    return EXIT_FAIL


def last_conclusion(out):
    for ln in reversed((out or "").splitlines()):
        s = ln.strip()
        if s.startswith("结论：") or s.startswith("✗ [") or s.startswith("✓ "):
            return s
    return None


# ══════════════════════════════════════════════════════════════════
# 12. 命令行
# ══════════════════════════════════════════════════════════════════

USAGE = """用法：
  python3 scripts/edit-assert --rule <rule.yml> --target <f> --expect N [--reason <why>] [--write]
  python3 scripts/edit-assert --rule <rule.yml> --target <f> --unique [--write]
  python3 scripts/edit-assert --rule <rule.yml> --target <f> --set N1,N2 --reason <why>
  python3 scripts/edit-assert --group <一组断言.json> [--write]
  python3 scripts/edit-assert --self-test              自检（自身先自证；不过 ⇒ 拒绝跑真目标）
  python3 scripts/edit-assert --list-assertions        断言登记表（负控点名的名字从这来）
  python3 scripts/edit-assert --neg-control=<断言名>   负控（成对 + 点名）
  python3 scripts/edit-assert --help / --version

选项：
  --rule PATH           规则文件（**唯一**定位入口：ast-grep scan -r <rule.yml> --json）
  --target PATH         目标文件
  --expect N / --unique / --set N1,N2 / --group FILE     四种命中数断言形态（§4.2）
  --reason TEXT         期望值的理由（集合形态**必须**给；§4.2：必须能回答「为什么是 N」）
  --write               真写盘（缺省 = dry-run 只读预览，不写盘）；配 --replace-from/--replace-to
  --replace-from TEXT   命中文本必须逐字等于它（写盘**前**断言；不符 ⇒ 零改动 rc=1）
  --replace-to TEXT     替换成它（写盘经原子替换：同目录临时文件 + os.replace）
  --actor NAME          谁改的（默认 $ZERG_ACTOR / $USER）· --role author|verifier（默认 author）
  --sandbox-root PATH   副本根（role=verifier 时**必需**：verifier 行必须带只读副本路径）
  --ledger-path PATH    显式覆盖台账路径（测试用）—— **不许静默退化到 /tmp**
  --clock SEC           墙钟上界（默认 60；本机**没有** `timeout` 命令 ⇒ 上界只能自带）
  --diff-cmd CMD        覆盖 E4 的外部命令（默认 `git diff -U0 --`；只读 git，禁写）
  --ast-grep PATH       覆盖 ast-grep 路径（仍须过「登记路径 + binary sha256」启动断言）
  --no-self-test        跳过「真跑前先自检」（**内部/自检自己用的子进程形态**，防递归）
  --neg=<断言名>        内部开关：把该断言**取反**（负控形态专用）

退出码：0 通过 / 1 失败（含负控成立）/ 2 **不给结论**（缺件 · 不可解析 · 超时 · 台账未收尾 ·
        用法错 · 自检不过 · 负控坏名或拆不动）—— 2 不是红，是**没有结论**，且**没有文本锚点降级路径**"""


def print_list_assertions():
    print("════════════════════════════════════════════════════════════════")
    print("edit-assert %s 断言登记表（负控 `--neg-control=<断言名>` 点名的名字从这来）" % VERSION)
    for i, (name, what, how, inv) in enumerate(ASSERTIONS, 1):
        print("[%2d] %s" % (i, name))
        print("     判什么：%s" % what)
        print("     形态：%s" % how)
        print("     取反后：%s" % inv)
    print("── 原因码全集（%d 条 · 每条自带档位）──" % len(REASON_CODES))
    for code, tier, desc in REASON_CODES:
        print("  rc=%d  %-28s %s" % (tier, code, desc))
    print("── 前置顺序（写死 · J4）── ① 台账 → ② 缺件 → ③ 可解析 → ④ 命中数")
    print("── 定位路径（写死 · R-8）── ast-grep scan -r <rule.yml> --json ⇒ 取数组长度，rc 一律不采信")
    print("── 四形态 ── 精确 --expect N · 唯一 --unique · 集合 --set N1,N2 --reason … · 一组 --group <json>")
    print("── 台账 ── %s/edit-assert-ledger.jsonl（§7.4；文件名不含日期；begin/end 两行；启动未收尾检测）"
          % STATE_DIR_DEFAULT)
    print("── 规则模板 ── %s（强制 inside{stopBy: end} + has{field: name}）"
          % os.path.relpath(RULE_TEMPLATE, REPO_ROOT))
    print("── 工具账 ── %s（CLI 依赖账；启动断言：路径/指纹不符 ⇒ rc=2）"
          % os.path.relpath(TOOLS_ACCOUNT, REPO_ROOT))
    return EXIT_OK


def parse_args(argv):
    cfg = {"rule": None, "target": None, "group": None, "write": False, "actor": None, "role": "author",
           "ledger_path": None, "clock": 60, "diff_cmd": None, "ast_grep": None, "sandbox_root": None,
           "expect": None, "form": None, "reason": None, "replace_from": None, "replace_to": None,
           "mode": None, "neg_control": None, "neg": set(), "no_self_test": False, "n_targets": 1}
    i = 0
    while i < len(argv):
        v = argv[i]

        def need(what, _i=i):
            if _i + 1 >= len(argv):
                raise Blocked("BLOCKED_USAGE", "%s 后面缺参数" % what)
            return argv[_i + 1]

        if v == "--rule":
            cfg["rule"] = need(v); i += 2
        elif v == "--target":
            cfg["target"] = need(v); i += 2
        elif v == "--group":
            cfg["group"] = need(v); i += 2
        elif v == "--expect":
            raw = need(v); i += 2
            try:
                cfg["expect"] = int(raw)
            except ValueError:
                raise Blocked("BLOCKED_USAGE", "--expect 必须是整数：%r" % raw)
            cfg["form"] = "唯一" if cfg["expect"] == 1 else "精确"
        elif v == "--unique":
            cfg["expect"], cfg["form"] = 1, "唯一"; i += 1
        elif v == "--set":
            raw = need(v); i += 2
            try:
                cfg["expect"] = sorted(set(int(x) for x in raw.split(",") if x.strip() != ""))
            except ValueError:
                raise Blocked("BLOCKED_USAGE", "--set 必须是逗号分隔整数：%r" % raw)
            if not cfg["expect"]:
                raise Blocked("BLOCKED_USAGE", "--set 给空了：%r" % raw)
            cfg["form"] = "集合"
        elif v == "--reason":
            cfg["reason"] = need(v); i += 2
        elif v == "--replace-from":
            cfg["replace_from"] = need(v); i += 2
        elif v == "--replace-to":
            cfg["replace_to"] = need(v); i += 2
        elif v == "--write":
            cfg["write"] = True; i += 1
        elif v == "--actor":
            cfg["actor"] = need(v); i += 2
        elif v == "--role":
            cfg["role"] = need(v); i += 2
            if cfg["role"] not in ("author", "verifier"):
                raise Blocked("BLOCKED_USAGE", "--role 只允许 author|verifier：%r" % cfg["role"])
        elif v == "--sandbox-root":
            cfg["sandbox_root"] = need(v); i += 2
        elif v == "--ledger-path":
            cfg["ledger_path"] = need(v); i += 2
        elif v == "--clock":
            raw = need(v); i += 2
            try:
                cfg["clock"] = int(raw)
            except ValueError:
                raise Blocked("BLOCKED_USAGE", "--clock 必须是整数秒：%r" % raw)
        elif v == "--diff-cmd":
            cfg["diff_cmd"] = need(v); i += 2
        elif v == "--ast-grep":
            cfg["ast_grep"] = need(v); i += 2
        elif v == "--no-self-test":
            cfg["no_self_test"] = True; i += 1
        elif v.startswith("--neg="):
            cfg["neg"].add(v.split("=", 1)[1]); i += 1
        elif v.startswith("--neg-control="):
            cfg["neg_control"] = v.split("=", 1)[1]; cfg["mode"] = "neg-control"; i += 1
        elif v == "--neg-control":
            cfg["neg_control"] = need(v); cfg["mode"] = "neg-control"; i += 2
        elif v == "--self-test":
            cfg["mode"] = "self-test"; i += 1
        elif v == "--list-assertions":
            cfg["mode"] = "list"; i += 1
        elif v in ("-h", "--help"):
            cfg["mode"] = "help"; i += 1
        elif v in ("-V", "--version"):
            cfg["mode"] = "version"; i += 1
        else:
            raise Blocked("BLOCKED_USAGE", "未知参数：%s（--help 看用法）" % v)
    if cfg["actor"] is None:
        cfg["actor"] = os.environ.get("ZERG_ACTOR") or os.environ.get("USER") or "unknown"
    return cfg


def build_specs(cfg):
    if cfg["group"]:
        path = cfg["group"]
        if not os.path.isfile(path):
            raise Blocked("BLOCKED_MISSING_TARGET", "--group 文件不存在：%s" % path)
        try:
            with open(path, "r", encoding="utf-8") as fh:
                data = json.load(fh)
        except (IOError, OSError, ValueError) as exc:
            raise Blocked("BLOCKED_USAGE", "--group 文件不可解析：%s（%s）" % (path, exc))
        items = data.get("assertions") if isinstance(data, dict) else None
        if not isinstance(items, list) or not items:
            raise Blocked("BLOCKED_USAGE", "--group 文件里没有非空 `assertions` 列表")
        specs = []
        for i, it in enumerate(items, 1):
            if not isinstance(it, dict):
                raise Blocked("BLOCKED_USAGE", "assertions[%d] 不是对象" % i)
            for k in ("rule", "target", "expect", "reason"):
                if k not in it:
                    raise Blocked("BLOCKED_USAGE",
                                  "assertions[%d] 缺字段 `%s`（形态 4 = (target, expect, reason)）" % (i, k))
            specs.append({"rule": it["rule"], "target": it["target"], "expect": int(it["expect"]),
                          "form": "一组", "reason": it["reason"],
                          "replace_from": it.get("replace_from"), "replace_to": it.get("replace_to"),
                          "name": it.get("name") or "a%d" % i})
        cfg["n_targets"] = len(specs)
        return specs
    if not cfg["target"] or cfg["rule"] is None:
        raise Blocked("BLOCKED_USAGE", "必须给 `--rule` 与 `--target`（或 --group <json>）")
    if cfg["form"] is None:
        raise Blocked("BLOCKED_USAGE", "必须给期望值形态之一：--expect N / --unique / --set N1,N2（或 --group）")
    cfg["n_targets"] = 1
    return [{"rule": cfg["rule"], "target": cfg["target"], "expect": cfg["expect"], "form": cfg["form"],
             "reason": cfg["reason"], "replace_from": cfg["replace_from"], "replace_to": cfg["replace_to"],
             "name": "single"}]


def main(argv):
    try:
        cfg = parse_args(argv)
    except Blocked as exc:
        eprint("✗ [%s] %s" % (exc.code, exc.msg))
        eprint("✗ 结论：rc=2 **不给结论**（%s）" % REASON_DESC.get(exc.code, ""))
        print(USAGE)
        return EXIT_BLOCKED
    if cfg["mode"] == "help":
        print(USAGE)
        return EXIT_OK
    if cfg["mode"] == "version":
        print("edit-assert %s（腿二五步 E1–E5 · 判据 J1–J6 · 三档退码 0/1/2）" % VERSION)
        return EXIT_OK
    if cfg["mode"] == "list":
        return print_list_assertions()
    if cfg["mode"] == "self-test":
        return run_self_test()
    if cfg["mode"] == "neg-control":
        rest, skip = [], False
        for k, a in enumerate(argv):
            if skip:
                skip = False
                continue
            if a == "--neg-control":
                skip = True
                continue
            if a.startswith("--neg-control="):
                continue
            rest.append(a)
        return run_neg_control(cfg["neg_control"], rest)
    if cfg["mode"] is None and not argv:
        print(USAGE)
        eprint("✗ [BLOCKED_USAGE] 没有给任何模式/参数 ⇒ rc=2（不给结论）")
        return EXIT_BLOCKED
    if cfg["role"] == "verifier" and not cfg["sandbox_root"]:
        eprint("✗ [BLOCKED_USAGE] role=verifier 必须给 `--sandbox-root`"
               "（verifier 行必须带只读副本路径，§2.1.7/C13）")
        return EXIT_BLOCKED
    # 真跑前先自证（M15-②；同 precommit-gates.sh:36）
    if not cfg["no_self_test"]:
        if run_self_test() != EXIT_OK:
            eprint("✗ 自检不过 ⇒ 拒绝跑真目标（rc=2；precommit-gates.sh:36 的项目口径）")
            return EXIT_BLOCKED
    ctx = Ctx(cfg)
    try:
        specs = build_specs(cfg)
    except Blocked as exc:
        eprint("✗ [%s] %s" % (exc.code, exc.msg))
        print(USAGE)
        return EXIT_BLOCKED
    return gate(ctx, specs)


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        eprint("✗ 被中断 ⇒ rc=2 **不给结论**（写盘窗口内的复原由门按内存前像字节处理）")
        sys.exit(EXIT_BLOCKED)
    except SystemExit:
        raise
    except Exception as exc:            # 未预期异常：不许静默，也不许当绿
        import traceback
        traceback.print_exc()
        eprint("✗ 未预期异常 ⇒ rc=2 **不给结论**：%r" % (exc,))
        sys.exit(EXIT_BLOCKED)
