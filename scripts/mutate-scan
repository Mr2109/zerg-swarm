# tmp_cleaner 3 天未访问即删」）
TOOLS_DIR = os.environ.get("ZERG_TOOLS_DIR") or os.path.expanduser("~/.zerg/tools")

LEDGER_NAME = "edit-assert-ledger.jsonl"
GATE_ID = "mutate-scan"
# 逐字抄 scripts/chat-harness.py:30（同默认、同 env 名）；与 edit-assert 同文件不同 role
STATE_DIR_DEFAULT = os.environ.get("ZERG_STATE_DIR", os.path.expanduser("~/.zerg/state"))
if not STATE_DIR_DEFAULT:
    STATE_DIR_DEFAULT = os.path.expanduser("~/.zerg/state")

TMP_PREFIXES = ("/tmp/", "/private/tmp/", "/var/tmp/", "/private/var/tmp/")

EXIT_OK, EXIT_FAIL, EXIT_BLOCKED = 0, 1, 2

# 六态（§2.1.3）+ 干跑态（**不是**六态之一）
SIX_STATES = ["KILLED", "LIVED", "NOT COVERED", "TIMED OUT", "NOT VIABLE", "SKIPPED"]
DRY_STATE = "RUNNABLE"
STATE_MEANING = {
    "KILLED": "变异被杀 ⇒ 判据有牙齿（门在工作）",
    "LIVED": "变异存活 ⇒ 覆盖缺口 / 判据太弱（真红）",
    "NOT COVERED": "该点没有用例跑到 ⇒ 覆盖缺口（不是门没牙齿）",
    "TIMED OUT": "变异体超时 ⇒ 配置/规模问题（系数/包大小/并发）；实测撞过这一态",
    "NOT VIABLE": "变异使构建失败 ⇒ 不合法变异体，剔除、不计分",
    "SKIPPED": "被 --diff/过滤跳过 ⇒ **未验**，不许计入任何结论",
}

# 归一白名单：**只剔时间/派生计数**，逐字段写理由（§2.1.4 / Q10：禁止为「让 J3 绿」扩大白名单）
NORM_WHITELIST = [
    ("elapsed_time", "计时漂移（实测同输入两跑必不同）"),
    ("test_efficacy", "派生自状态计数（跑的形态不同即不同）"),
    ("mutations_coverage", "派生自状态计数"),
    ("mutator_statistics", "派生计数（按类型统计）"),
    ("mutants_total", "派生计数（干跑恒 0、真跑为可跑点数 —— 实测）"),
    ("mutants_killed", "派生计数"),
    ("mutants_lived", "派生计数"),
    ("mutants_not_viable", "派生计数"),
    ("mutants_not_covered", "派生计数"),
]
NORM_WHITELIST_KEYS = [k for k, _r in NORM_WHITELIST]

# ── 原因码全集（每条自带档位；j4 要求每段自带原因码）────────────────────────────────
