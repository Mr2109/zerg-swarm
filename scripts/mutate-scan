    "A17_TOOL_BROKEN": "load_manifest（工具坏判定处）",
}

# 负控的「绿形态」（**只有在该形态下这条断言才接在判定上**；--neg-form 可覆盖）
NEG_FORMS = ("manifest", "point", "manifest-j3", "py-point")
NEG_GREEN_FORM = {
    "A6_NARROW_SINGLE": "point",
    "A7_SIX_STATES": "point",
    "A15_CR_STDOUT_JSON": "py-point",
    "A16_J3_STABLE": "manifest-j3",
    # A11_RESTORE_SHA 故意留在清单形态：清单不写目标 ⇒ 残留判定不接 ⇒ 负控如实报 NOTOOTH
    # （自检就用这一格证明「无牙」检测在工作；要成对：--neg-control=A11_RESTORE_SHA --neg-form point）
}

GREMLINS_TYPE_FLAGS = {
    "arithmetic-base": "ARITHMETIC_BASE",
    "conditionals-boundary": "CONDITIONALS_BOUNDARY",
    "conditionals-negation": "CONDITIONALS_NEGATION",
    "invert-assignments": "INVERT_ASSIGNMENTS",
    "invert-bitwise": "INVERT_BITWISE",
