# 虫族环境变量示例 —— 复制为 .env 并填入真实值（.env 不入库）
# Zerg environment-variable template — copy to .env and fill in real values (.env is never committed)
#
#   cp .env.example .env && $EDITOR .env
#   set -a; . ./.env; set +a
#
# ⚠️ 路径含空格/中文时必须用双引号，否则 `set -a; . ./.env` 会把空格后的部分当作命令执行，
#    变量被静默截断。例：ZERG_KB_PATH="/Volumes/My Disk/knowledge.db"
# ⚠️ Quote any value that contains spaces (or non-ASCII), e.g. ZERG_KB_PATH="/Volumes/My Disk/kb.db"
#    — otherwise sourcing this file truncates the variable at the first space, silently.
#
# ── 共享认证令牌（必填）─────────────────────────────────────────
# 权威来源三选一（优先级从高到低）：
#   1. 环境变量 ZERG_AUTH_TOKEN（兼容旧名 ZERG_API_TOKEN）
#   2. 文件 ~/.zerg/token（单行；仓库外，推荐）
#   3. 本文件 + `set -a; . ./.env; set +a`
# 生成建议：openssl rand -hex 32
ZERG_AUTH_TOKEN=change-me-please

# ── 集群子端（可选，部署脚本用）─────────────────────────────────
# X3_HOST=g01@<x3-address>
# 若已配置 ssh key 免密，无需 X3_PASS（推荐）；否则显式提供，勿写默认值
# X3_PASS=

# ── 运行目录（可选，均有默认值）─────────────────────────────────
# ZERG_STATE_DIR=~/.zerg/state        # 工具计数/事件/错误桶
# ZERG_CHAT_DB_PATH=~/.zerg-chat/chat.db
# ZERG_EXTRA_ALLOW_DIR=               # CA 任务额外白名单目录（冒号分隔）
# ZERG_LOG_LEVEL=info

# ── 模型与后端（可选）───────────────────────────────────────────
# UI 文档 AI 动作（总结/续写/翻译/润色）用的模型（不设则 AI 动作会提示去配置）
# ZERG_AI_MODEL=<model-id>          # 也可写进 ~/.zerg-ui-prefs.json 的 ai_model
# ZERG_GATEWAY_URL=http://127.0.0.1:8082
# ZERG_ORNITH_TEMPLATE=~/.zerg/ornith_chat_template.jinja

# ── 可选：外部数据位置（不设则用仓库内默认/功能禁用）─────────────
# ZERG_KB_PATH="/path/to/knowledge.db"      # 知识库 SQLite（含空格必须引号 / quote if the path has spaces）
# ZERG_SEARXNG_PY=/path/to/python3          # searxng 解释器（自建）
# ZERG_SEARXNG_SETTINGS=/path/to/settings.yml
# ZERG_AUTOCUT_DIR= / ZERG_MUSIC_DIR=       # 影音工具链目录
# ZERG_RTK=0                                # 关闭 rtk 命令包装
# ZERG_WORKSPACE="/path/to/zerg-swarm"      # 工作区根（默认自动推断 / quote if it has spaces）
# ZERG_TMP_DIR=/tmp                         # 临时根（任务目录/日志/缓存）
# ZERG_PORT=8580 / ZERG_GATEWAY_PORT=8082 / ZERG_AGENT_PORT=8100
