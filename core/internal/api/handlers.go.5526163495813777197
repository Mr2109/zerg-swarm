// firstLine 取首行（简介——一句话——2026-08-21 Mr2109）
func firstLine(s string) string {
	if i := strings.IndexAny(s, "\n."); i >= 0 {
		s = s[:i]
	}
	if len(s) > 60 {
		s = s[:60] + "…"
	}
	return s
}

