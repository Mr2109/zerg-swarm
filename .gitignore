# 模型文件不进 git（7.5GB，用 git-lfs 或本地存储）
compress_models/
core/.zerg/
core/internal/agent/test_deadcode/
.hermes/
.zerg/
bin/zerg-core
agent/bin/
app/dist/
# 2026-09-20 修：data/ 整目录忽略会让新克隆缺目录（代码有 232 处引用它 ✗）
# 改成 data/* + 白名单占位（gitignore 规则：父目录被排除时无法再包含其下文件 ⇒ 必须用 data/*）
data/*
!data/README.md
core/internal/agent/设计-*.md
core/zerg-scheduler
cmd/zerg-scheduler/zerg-scheduler
core/zerg-api
core/zerg-api
core/zerg-api
core/zerg-review
zerg-wt/
bin/zerg-core.old

# 构建产物不入库(2026-09-08 政策)
bin/

# patch 残片不入库（2026-09-11 一致性审计：tools.go.orig/.rej 曾长期被跟踪）
*.orig
*.rej

# 子项目根下的编译产物（与 agent/bin 同类）
/core/zerg-agent
/agent/zerg-agent

# 数据库文件不入库（2026-09-11：footage.db 空占位符曾入库；运行时自建）
*.db

# 本地环境变量（含令牌——绝不入库；2026-09-11 A 批）
.env
.env.local

# 编辑器/工具临时备份（形如 file.go.5526163495813777197）——不入库
*.[0-9][0-9][0-9][0-9][0-9][0-9][0-9]*

# Python 编译缓存 / 原生产物（不入库）
__pycache__/
*.pyc
*.pyo
*.o
*.a
*.so
*.dylib
*.class

# 发布制品（scripts/build/build-all.sh --dist：二进制 + checksums.txt）——入库会让公开快照带编译产物
/dist/

# 安装方式印记（B3 `zerg update`：代码树旁的 .install_method = git/fleet/unknown）
# 是"这台机器怎么装的"的运行时属性，不该入库（照抄 Hermes 的 /.install_method）
/.install_method
# macOS 目录元数据（登记层忽略，不改物理文件）
.DS_Store
**/.DS_Store

# 配置备份（登记层忽略；gateway/ 属私有面，不给 .bak 留缝）
gateway/*.bak-*
*.bak-2026*

# 运行期产物（2026-09-20「目录归真」登记层）：顶层只允许四类东西（模块/生命周期/元文件/点目录）
/internal-task-report.md
/task-internal-*/
/core/zerg

# ★ 2026-09-27 追加（Mr2109 批准）：点目录与无名残渣曾靠上面「顶层四类」注释合法绕过
#   ⇒ .stage/ 是试验落地目录（含机器专属 plist）、ID 是 0 字节重定向残渣，两者皆点名忽略
/.stage/
/ID
scripts/gates/_history/

# ★ 2026-10-03 追加（GAP-20260927-223 ② · 候件）：private/ = 「仓内但不入库」的真实业务件落点。
#   动机：这类件此前落在 .hermes/desktop-attachments/（靠 .hermes/ 顺带被忽略）——没有**点名**的落点，
#   换台机器/换目录就会漏成「未跟踪 + 未忽略」；且忽略 ≠ 有备份，须配单独备份策略（见 GAP 正文「护数据」）。
#   登记层忽略；不改任何物理件。如改判为「迁出仓外」，删本行即可（零随动）。
/private/

# ★ 2026-10-04 追加（门新鲜度 · D12 治法②）：seal 模块运行期落点（`last-green.json`）——
#   `core/cmd/zerg/gate_freshness.go` 的 `lastGreenRel` 落 `scripts/gates/seal/.runtime/last-green.json`，
#   它是「记着指纹的件」；未 ignore ⇒ 每跑一趟门就脏一个未跟踪件（固定点未治）。
#   → 登记层忽略该子目录；与同族运行期落点 `scripts/gates/_history/`（上方）同规。
scripts/gates/seal/.runtime/

# ★ 2026-10-09 追加（Q-211 治法 · 甲类）：跑门台账每跑一趟门就追加一行 ⇒ 它**必然**比索引新一件；
#   跟踪它 = 每次提交后工作树立刻变脏 ⇒ 制品永远带 `+dirty` ⇒ `Q-211` 身份行结构性判不了绿（实测：
#   四页 drift 全"无"、源码面"自 X 起无改动"，唯一红格就是制品后缀 `+dirty`）。
#   → 登记层摘出（`git rm --cached`）+ 忽略；**盘上文件原样保留**当证据（回执另有 receipts/R-*.json 正门）。
#   与同族运行期落点 `scripts/gates/seal/.runtime/`、`scripts/gates/_history/` 同规。
scripts/gates/judge-run-ledger.jsonl
